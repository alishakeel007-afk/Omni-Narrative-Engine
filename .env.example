# Supabase PostgreSQL connection string used by Prisma.
# Use URL encoding for special characters in the password.
# Example: if password is my@pass, write my%40pass in the URL.
# Example:
# Copy the exact Supavisor transaction-pooler URL from Supabase Dashboard > Connect.
# It must use port 6543 and require TLS. Add pgbouncer=true for Prisma when needed.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require"

# Direct connection string used by Prisma CLI migrations.
# Copy Supabase's direct connection string, URL-encode the password, and require TLS.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional path to the Supabase database CA PEM. Required when the host does not
# already trust the Supabase CA; TLS verification remains enabled either way.
# Keep the certificate outside source control.
SUPABASE_DB_CA_PATH="C:/secure-path/prod-ca-2021.crt"

# Used to sign HTTP-only auth session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_random_64_character_hex_string"

# Supabase project values for future storage uploads.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# AI providers
GEMINI_API_KEY="your_gemini_key"
GEMINI_MODEL="gemini-2.5-flash"
# Video Studio tries Groq first, then Gemini once if Groq is unavailable.
GROQ_API_KEY="your_groq_key"
GROQ_MODEL="qwen/qwen3.8-27b"
DEEPGRAM_TTS_API_KEY="your_deepgram_key"
DEEPGRAM_TTS_MODEL="aura-2-thalia-en"
BACKGROUND_MUSIC_API_KEY="your_music_provider_key"
# ElevenLabs - Urdu Text-to-Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_URDU_HERO_MALE_VOICE_ID=your_urdu_hero_male_voice_id_here
# Optional Urdu Eleven v3 character voices. Add only IDs you have explicitly
# approved and auditioned; missing mappings deliberately block that clip.
ELEVENLABS_URDU_NARRATOR_VOICE_ID=
ELEVENLABS_URDU_HERO_FEMALE_VOICE_ID=
ELEVENLABS_URDU_VILLAIN_MALE_VOICE_ID=
ELEVENLABS_URDU_VILLAIN_FEMALE_VOICE_ID=
ELEVENLABS_URDU_MENTOR_MALE_VOICE_ID=
ELEVENLABS_URDU_MENTOR_FEMALE_VOICE_ID=
ELEVENLABS_URDU_ELDER_MALE_VOICE_ID=
ELEVENLABS_URDU_ELDER_FEMALE_VOICE_ID=
ELEVENLABS_URDU_YOUNG_MALE_VOICE_ID=
ELEVENLABS_URDU_YOUNG_FEMALE_VOICE_ID=
ELEVENLABS_URDU_CHILD_VOICE_ID=
ELEVENLABS_URDU_CREATURE_ROBOT_VOICE_ID=
ELEVENLABS_URDU_NEUTRAL_MALE_VOICE_ID=
ELEVENLABS_URDU_NEUTRAL_FEMALE_VOICE_ID=

# Transactional email for password reset links.
# Resend docs: https://resend.com/docs/api-reference/emails
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="Omni Narrative <onboarding@resend.dev>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only video generation
MAGIC_HOUR_API_KEY=
SUPABASE_AUDIO_BUCKET="generated-audio"
SUPABASE_IMAGE_BUCKET="generated-images"
SUPABASE_VIDEO_BUCKET="generated-videos"

# Story images use Cloudflare Workers AI, including up to four reference inputs.
STUDIO_IMAGE_BACKEND="cloudflare"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Existing optional legacy backends: magic-hour or qwen. No automatic paid fallback.
# Existing provider option: flux-2-klein (6 total inputs) or qwen-edit (3 inputs).
STUDIO_MAGIC_HOUR_IMAGE_MODEL="flux-2-klein"
# HTTPS Modal endpoint, or http://127.0.0.1:8001 for a capable local GPU host.
STUDIO_QWEN_URL=
# Match the worker secret; generate a random value of at least 32 characters.
STUDIO_QWEN_TOKEN=

# Native LTX-2.5 audiovisual generation and CPU MP4 assembly (server only).
# Set to modal-ltx after deploying and preparing workers/video/app.py.
STUDIO_VIDEO_BACKEND="magic-hour"
STUDIO_LTX_URL=
# Must match STUDIO_LTX_TOKEN inside Modal's ltx25-api-secret.
STUDIO_LTX_TOKEN=
