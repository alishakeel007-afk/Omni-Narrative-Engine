    "test:studio:generate": "node tests/studio-generate.cjs",
    "test:studio:ltx": "node tests/studio-ltx.cjs",
    "test:studio:script": "node tests/studio-script.cjs",
    "test:studio:shots": "node tests/studio-shots.cjs",
