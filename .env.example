# Supabase PostgreSQL connection string used by Prisma.
# Use URL encoding for special characters in the password.
# Example: if password is my@pass, write my%40pass in the URL.
# Example:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# Direct connection string used by Prisma CLI migrations.
# Copy Supabase's direct connection string, URL-encode the password, and use it here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Used to sign HTTP-only auth session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_random_64_character_hex_string"

# Supabase project values for future storage uploads.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# AI providers
GEMINI_API_KEY="your_gemini_key"
GEMINI_MODEL="gemini-2.5-flash"
DEEPGRAM_TTS_API_KEY="your_deepgram_key"
DEEPGRAM_TTS_MODEL="aura-2-thalia-en"
BACKGROUND_MUSIC_API_KEY="your_music_provider_key"
